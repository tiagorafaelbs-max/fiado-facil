{
  "expo": {
    "name": "FiadoApp",
    "slug": "fiado-facil",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fiadofacil",
    "description": "Controle suas vendas no fiado de forma simples e profissional. Cadastre clientes, registre vendas, cobre pelo WhatsApp e receba pelo Pix.",
    "primaryColor": "#14352A",
    "splash": {
      "image": "./assets/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#14352A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiadofacil.app",
      "buildNumber": "76",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a câmera para tirar foto do comprovante de venda.",
        "NSPhotoLibraryUsageDescription": "Usamos a galeria para selecionar foto do comprovante de venda.",
        "NSUserNotificationsUsageDescription": "Enviamos lembretes de vencimento de pagamentos.",
        "NSContactsUsageDescription": "Acessamos seus contatos para preencher automaticamente o nome e telefone ao cadastrar um cliente.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pt_BR",
        "CFBundleLocalizations": [
          "pt-BR",
          "pt"
        ]
      }
    },
    "android": {
      "package": "com.fiadofacil.app",
      "versionCode": 38,
      "splash": {
        "image": "./assets/icon-512.png",
        "resizeMode": "contain",
        "backgroundColor": "#14352A"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "FiadoApp",
      "shortName": "FiadoApp",
      "description": "Controle suas vendas no fiado de forma simples e profissional."
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-file-system",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#14352A"
        }
      ]
    ],
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d8d7d3b3-83de-4260-84a8-8da259550bfe"
      }
    },
    "owner": "tiago-batista-organizacoes",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/d8d7d3b3-83de-4260-84a8-8da259550bfe"
    }
  }
}
