# Espelha .gitignore -- com .easignore presente, o .gitignore é TOTALMENTE
# ignorado pra decidir o que sobe no build da EAS. Sem isto, .env e
# google-service-account.json subiam pro servidor mesmo não estando no git
# (achado do Tiago, 30/09).
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.metro-health-check*

npm-debug.*
yarn-debug.*
yarn-error.*

.DS_Store
*.pem

.env*.local
.env

google-service-account.json
*-service-account.json
service-account*.json
*.keystore

*.aab
*.apk

supabase/.temp/
*.tsbuildinfo

/ios
/android

